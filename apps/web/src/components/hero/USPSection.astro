---
import { TreePine, Fence, CarFront, Zap, Flame, Volume2, Navigation, TrendingUp } from "lucide-astro";
import type { Locale } from "@lib/i18n/translations";

const locale = (Astro.currentLocale ?? "uk") as Locale;

const items = [
  {
    icon: "treepine",
    text: locale === "uk" ? "Власна земельна ділянка" : "Private land plot",
  },
  {
    icon: "fence",
    text: locale === "uk" ? "Прибудинкова територія для відпочинку, барбекю або дитячої зони" : "Yard for recreation, barbecue or children's area",
  },
  {
    icon: "car",
    text: locale === "uk" ? "Вбудоване паркомісце біля будинку" : "Built-in parking near the house",
  },
  {
    icon: "zap",
    text: locale === "uk" ? "Сучасні енергоефективні технології будівництва" : "Modern energy-efficient construction technologies",
  },
  {
    icon: "flame",
    text: locale === "uk" ? "Автономне опалення" : "Autonomous heating",
  },
  {
    icon: "volume",
    text: locale === "uk" ? "Тиша та комфорт приватного сектору" : "Quiet comfort of private sector",
  },
  {
    icon: "nav",
    text: locale === "uk" ? "Зручний виїзд до центру Києва" : "Convenient access to Kyiv center",
  },
  {
    icon: "trending",
    text: locale === "uk" ? "Високий потенціал зростання вартості нерухомості" : "High property value growth potential",
  },
];
---

<section class="section relative overflow-hidden bg-[var(--ph-surface)]">
  <div class="container-ph">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--ph-forest)]">
        {locale === "uk" ? "Переваги" : "Advantages"}
      </span>
      <h2 class="mt-3">
        {locale === "uk" ? "Переваги наших дуплексів" : "Advantages of our duplexes"}
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {items.map(({ icon, text }, idx) => (
        <div
          class="reveal rounded-[var(--ph-radius-xl)] border border-[var(--ph-border-strong)] bg-[var(--ph-bg)] p-5 shadow-[var(--ph-shadow-sm)]"
          style={`transition-delay: ${idx * 60}ms;`}
        >
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-[var(--ph-radius-md)] bg-[var(--ph-forest)]/[0.1] text-[var(--ph-forest)]">
            {icon === "treepine" && <TreePine size={22} strokeWidth={1.5} />}
            {icon === "fence" && <Fence size={22} strokeWidth={1.5} />}
            {icon === "car" && <CarFront size={22} strokeWidth={1.5} />}
            {icon === "zap" && <Zap size={22} strokeWidth={1.5} />}
            {icon === "flame" && <Flame size={22} strokeWidth={1.5} />}
            {icon === "volume" && <Volume2 size={22} strokeWidth={1.5} />}
            {icon === "nav" && <Navigation size={22} strokeWidth={1.5} />}
            {icon === "trending" && <TrendingUp size={22} strokeWidth={1.5} />}
          </div>

          <p class="text-[0.8125rem] font-medium leading-snug text-[var(--ph-ink)]">
            {text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
