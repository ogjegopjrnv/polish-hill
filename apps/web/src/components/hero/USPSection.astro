---
import { TreePine, BadgeDollarSign, ShieldCheck, Medal } from "lucide-astro";
import type { Locale } from "@lib/i18n/translations";

const locale = (Astro.currentLocale ?? "uk") as Locale;

const items = [
  {
    icon: "treepine",
    title: locale === "uk" ? "Парк Наталка та Дніпро" : "Natalka Park & Dnipro",
    text: locale === "uk"
      ? "Урочище Наталка — одна з найзеленіших зон Києва. Парк, набережна Дніпра та природа в пішій доступності"
      : "Natalka tract — one of Kyiv's greenest areas. Park, Dnipro embankment and nature within walking distance",
  },
  {
    icon: "dollar",
    title: locale === "uk" ? "Від $1 000/м²" : "From $1,000/m²",
    text: locale === "uk"
      ? "Безвідсоткове розтермінування до 18 місяців від забудовника. Без участі банків"
      : "Interest-free installment for up to 18 months from developer. No banks involved",
  },
  {
    icon: "shield",
    title: locale === "uk" ? "Юридична чистота" : "Legal clarity",
    text: locale === "uk"
      ? "КДТ «Чорнобилець» з 1996 року. Земельні ділянки надані рішеннями органів влади. Повний супровід"
      : "KDT Chornobylec since 1996. Land plots granted by government decision. Full legal support",
  },
  {
    icon: "medal",
    title: locale === "uk" ? "Знижки для ЗСУ" : "Military discounts",
    text: locale === "uk"
      ? "5% для військовослужбовців. 5% для сімей загиблих Захисників і Захисниць України"
      : "5% for military personnel. 5% for families of fallen Defenders of Ukraine",
  },
];
---

<section class="section relative overflow-hidden bg-[var(--ph-surface)]">
  <div class="container-ph">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--ph-forest)]">
        {locale === "uk" ? "Переваги" : "Advantages"}
      </span>
      <h2 class="mt-3">
        {locale === "uk" ? "Чому обирають наші дуплекси" : "Why choose our duplexes"}
      </h2>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {items.map(({ icon, title, text }, idx) => (
        <div
          class="reveal relative rounded-[var(--ph-radius-xl)] border border-[var(--ph-forest)]/20 bg-[var(--ph-bg)] p-7 shadow-[var(--ph-shadow-lg)]"
          style={`transition-delay: ${idx * 80}ms;`}
        >
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-[var(--ph-radius-lg)] bg-[var(--ph-forest)]/[0.12] text-[var(--ph-forest)]">
            {icon === "treepine" && <TreePine size={26} strokeWidth={1.5} />}
            {icon === "dollar" && <BadgeDollarSign size={26} strokeWidth={1.5} />}
            {icon === "shield" && <ShieldCheck size={26} strokeWidth={1.5} />}
            {icon === "medal" && <Medal size={26} strokeWidth={1.5} />}
          </div>

          <h3 class="text-[1.125rem]">{title}</h3>
          <p class="mt-2.5 text-[0.875rem] leading-relaxed text-[var(--ph-ink-soft)]">
            {text}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
