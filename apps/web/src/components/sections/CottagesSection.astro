---
import { lots, formatPrice } from "@data/lots";
import type { Locale } from "@lib/i18n/translations";

const locale = (Astro.currentLocale ?? "uk") as Locale;
const availableCount = lots.filter((l) => l.status === "available").length;

// Zone positions aligned to actual building edges in duplex-1.jpg (1280px wide)
// Left duplex: ~65–590px, right duplex: ~690–1215px
// Zone positions from pixel analysis of duplex-1.jpg (1280×709):
// Left duplex x=70–540, division at x=305; right duplex x=700–1210, division at x=975
const zones = [
  { id: "duplex-a2", label: "A2", area: 200, price: 200_000, left: 5.5, width: 18.3 },
  { id: "duplex-a1", label: "A1", area: 195, price: 195_000, left: 23.8, width: 18.4 },
  { id: "duplex-b2", label: "B2", area: 200, price: 200_000, left: 54.7, width: 21.5 },
  { id: "duplex-b1", label: "B1", area: 195, price: 195_000, left: 76.2, width: 18.5 },
];
---

<section id="cottages" class="section bg-[var(--ph-surface)]">
  <div class="container-ph">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--ph-forest)]">
        {locale === "uk" ? "Продаж відкрито" : "Now selling"}
      </span>
      <h2 class="mt-3">
        {locale === "uk" ? "Оберіть свій дуплекс" : "Choose your duplex"}
      </h2>
      <p class="mt-4 text-[var(--ph-ink-soft)]">
        {locale === "uk"
          ? `${availableCount} секції вільні. Натисніть на секцію для деталей.`
          : `${availableCount} sections available. Click a section for details.`}
      </p>
    </div>

    <!-- Desktop: interactive duplex map -->
    <div class="duplex-map reveal relative mt-14 hidden overflow-hidden rounded-[var(--ph-radius-2xl)] md:block">
      <img
        src="/images/client/duplex-1.jpg"
        alt="Дуплекси — фронтальний вигляд"
        class="w-full block"
        loading="lazy"
        decoding="async"
      />

      {zones.map((z) => (
        <div
          class="zone"
          style={`left: ${z.left}%; width: ${z.width}%;`}
          data-cottage-trigger={z.id}
          role="button"
          tabindex="0"
          aria-label={`Секція ${z.label}, ${z.area} м², ${formatPrice(z.price)}`}
        >
          <div class="zone-label">
            <span class="zone-name">Секція {z.label}</span>
            <span class="zone-specs">{z.area} м² · {formatPrice(z.price)}</span>
          </div>
        </div>
      ))}

      <div class="duplex-group-label" style="left: 24%;">Дуплекс A</div>
      <div class="duplex-group-label" style="left: 76.2%;">Дуплекс B</div>
    </div>

    <!-- Mobile: horizontal scroll -->
    <div class="mt-10 flex gap-3 overflow-x-auto pb-2 md:hidden [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {lots.map((lot) => (
        <div
          class="reveal w-[200px] shrink-0 cursor-pointer overflow-hidden rounded-[var(--ph-radius-xl)] border border-[var(--ph-border)] bg-[var(--ph-bg)] transition-all duration-200 active:scale-[0.98]"
          data-cottage-trigger={lot.id}
          role="button"
          tabindex="0"
        >
          <div class="relative aspect-[3/4] overflow-hidden">
            <img
              src={lot.image}
              alt={`Секція ${lot.number}`}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2 left-2 inline-flex items-center gap-1 rounded-full border bg-emerald-50 text-emerald-700 border-emerald-200 px-2 py-0.5 text-[0.5625rem] font-semibold">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              {locale === "uk" ? "Вільний" : "Available"}
            </span>
          </div>
          <div class="p-3">
            <div class="flex items-baseline justify-between">
              <h3 class="text-[0.875rem] font-semibold">Секція {lot.number}</h3>
              <span class="tabular-nums text-[0.875rem] font-bold text-[var(--ph-forest)]">{formatPrice(lot.totalPrice)}</span>
            </div>
            <p class="mt-1 text-[0.6875rem] text-[var(--ph-ink-muted)]">{lot.area} м² · 2 пов. + мансарда</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .zone {
    position: absolute;
    top: 5%;
    bottom: 5%;
    cursor: pointer;
    transition: all 0.35s ease;
    border-radius: var(--ph-radius-lg);
  }

  .zone::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgba(0, 0, 0, 0);
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }

  .duplex-map:hover .zone::before {
    background: rgba(0, 0, 0, 0.45);
  }

  .duplex-map .zone:hover::before {
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 0 0 3px var(--ph-forest);
  }

  .zone-label {
    position: absolute;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 10px 18px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-radius: var(--ph-radius-lg);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
    white-space: nowrap;
    z-index: 5;
  }

  .zone:hover .zone-label {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .zone-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ph-forest-deep);
  }

  .zone-specs {
    font-size: 0.75rem;
    color: var(--ph-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .duplex-group-label {
    position: absolute;
    top: 4%;
    transform: translateX(-50%);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: white;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    padding: 4px 14px;
    border-radius: 100px;
    pointer-events: none;
    z-index: 3;
  }

  :root[data-theme="dark"] .zone-label {
    background: rgba(30, 30, 30, 0.92);
  }
</style>
