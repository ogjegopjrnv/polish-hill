---
import { Trees, School, ShoppingCart, TrainFront, MapPin, Building2 } from "lucide-astro";
import type { Locale } from "@lib/i18n/translations";

const locale = (Astro.currentLocale ?? "uk") as Locale;

const pois = [
  { icon: "trees", label: locale === "uk" ? "Парк Наталка" : "Natalka Park", time: "5 хв", color: "text-emerald-600" },
  { icon: "school", label: locale === "uk" ? "Школа, садочок" : "School", time: "5 хв", color: "text-blue-600" },
  { icon: "cart", label: locale === "uk" ? "Супермаркети" : "Supermarkets", time: "5 хв", color: "text-orange-600" },
  { icon: "train", label: locale === "uk" ? "Метро Почайна" : "Metro Pochayna", time: "15 хв", color: "text-red-600" },
  { icon: "pin", label: locale === "uk" ? "Набережна Дніпра" : "Dnipro embankment", time: "7 хв", color: "text-cyan-600" },
  { icon: "city", label: locale === "uk" ? "Центр Києва" : "Kyiv center", time: "20 хв", color: "text-violet-600" },
];
---

<section id="location" class="section bg-[var(--ph-surface)]">
  <div class="container-ph">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
      <div class="reveal">
        <span class="text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--ph-forest)]">
          {locale === "uk" ? "Локація" : "Location"}
        </span>
        <h2 class="mt-3">
          {locale === "uk" ? "Урочище Наталка — зелене серце Оболоні" : "Natalka tract — green heart of Obolon"}
        </h2>
        <p class="mt-4 text-[var(--ph-ink-soft)]">
          {locale === "uk"
            ? "вул. Богатирська, 29а, Оболонський район. Парк Наталка, набережна Дніпра, повна інфраструктура — все поруч."
            : "29a Bohatyrska St., Obolon district. Natalka Park, Dnipro embankment, full infrastructure nearby."}
        </p>

        <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {pois.map(({ icon, label, time, color }) => (
            <div class="flex items-start gap-2.5 rounded-[var(--ph-radius-lg)] border border-[var(--ph-border)] bg-[var(--ph-bg)] px-3 py-3.5 sm:gap-3 sm:px-4">
              <div class:list={["shrink-0", color]}>
                {icon === "trees" && <Trees size={20} strokeWidth={1.5} />}
                {icon === "school" && <School size={20} strokeWidth={1.5} />}
                {icon === "cart" && <ShoppingCart size={20} strokeWidth={1.5} />}
                {icon === "train" && <TrainFront size={20} strokeWidth={1.5} />}
                {icon === "pin" && <MapPin size={20} strokeWidth={1.5} />}
                {icon === "city" && <Building2 size={20} strokeWidth={1.5} />}
              </div>
              <div class="min-w-0">
                <p class="text-[0.75rem] font-medium leading-snug text-[var(--ph-ink)] min-[390px]:text-[0.8125rem]">{label}</p>
                <p class="text-[0.75rem] text-[var(--ph-ink-muted)]">{time}</p>
              </div>
            </div>
          ))}
        </div>

        {/* How to get there */}
        <div class="mt-8 rounded-[var(--ph-radius-xl)] border border-[var(--ph-border)] bg-[var(--ph-bg)] p-5">
          <h4 class="text-[0.8125rem] font-semibold text-[var(--ph-ink)]">
            {locale === "uk" ? "Як дістатися" : "How to get there"}
          </h4>
          <p class="mt-2 text-[0.8125rem] leading-relaxed text-[var(--ph-ink-soft)]">
            {locale === "uk"
              ? "Метро «Почайна» → маршрут №296 → зупинка «Сади» → пішки до КДТ «Чорнобилець»."
              : "Metro Pochayna → route 296 → Sady stop → walk to KDT Chornobylec."}
          </p>
        </div>
      </div>

      <div class="reveal" style="transition-delay: 150ms;">
        <div class="overflow-hidden rounded-[var(--ph-radius-2xl)] shadow-[var(--ph-shadow-xl)]">
          <iframe
            src="https://maps.google.com/maps?q=50.5504214,30.4743529&hl=uk&z=15&output=embed"
            width="100%"
            height="400"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={locale === "uk" ? "Карта розташування дуплексів" : "Duplex location map"}
            class="aspect-[4/3] w-full"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
