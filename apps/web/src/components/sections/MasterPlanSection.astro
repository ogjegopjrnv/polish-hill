---
import type { Locale } from "@lib/i18n/translations";

const locale = (Astro.currentLocale ?? "uk") as Locale;

const floors = [
  { label: locale === "uk" ? "1-й поверх" : "1st floor", src: "/images/client/duplex-floor-1.jpg" },
  { label: locale === "uk" ? "2-й поверх" : "2nd floor", src: "/images/client/duplex-floor-2.jpg" },
  { label: locale === "uk" ? "3-й поверх" : "3rd floor", src: "/images/client/duplex-floor-3.jpg" },
];
---

<section id="masterplan" class="section bg-[var(--ph-bg)]">
  <div class="container-ph">
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--ph-forest)]">
        {locale === "uk" ? "Планування" : "Floor Plans"}
      </span>
      <h2 class="mt-3">
        {locale === "uk" ? "Планування поверхів" : "Floor plans"}
      </h2>
      <p class="mt-4 text-[var(--ph-ink-soft)]">
        {locale === "uk"
          ? "195–200 м² на 3 поверхи. Стан після будівельників. Натисніть для збільшення."
          : "195–200 m² across 3 floors. Shell & core condition. Tap to zoom."}
      </p>
    </div>

    {/* Desktop — 3 images horizontal */}
    <div class="reveal mt-12 hidden md:grid md:grid-cols-3 md:gap-6">
      {floors.map(({ label, src }) => (
        <div class="text-center">
          <img
            src={src}
            alt={label}
            class="w-full rounded-[var(--ph-radius-xl)] cursor-zoom-in shadow-[var(--ph-shadow-md)]"
            loading="lazy"
            decoding="async"
            data-plan-zoom
          />
          <p class="mt-3 text-[0.8125rem] font-semibold text-[var(--ph-forest)]">{label}</p>
        </div>
      ))}
    </div>

    {/* Mobile — vertical stack */}
    <div class="reveal mt-8 flex flex-col gap-6 md:hidden">
      {floors.map(({ label, src }) => (
        <div>
          <p class="mb-2 text-center text-[0.8125rem] font-semibold text-[var(--ph-forest)]">{label}</p>
          <img
            src={src}
            alt={label}
            class="w-full rounded-[var(--ph-radius-lg)] cursor-zoom-in"
            loading="lazy"
            decoding="async"
            data-plan-zoom
          />
        </div>
      ))}
    </div>

    {/* Технічні характеристики */}
    <div class="reveal mt-16">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--ph-forest)]">
          {locale === "uk" ? "Характеристики" : "Specifications"}
        </span>
        <h3 class="mt-3">
          {locale === "uk" ? "Технічні характеристики" : "Technical specifications"}
        </h3>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {([
          [locale === "uk" ? "Площа секцій" : "Section area", locale === "uk" ? "195 м² та 200 м²" : "195 m² and 200 m²"],
          [locale === "uk" ? "Зовнішні стіни" : "External walls", locale === "uk" ? "Газоблок D500." : "D500 gas block."],
          [locale === "uk" ? "Утеплення" : "Insulation", locale === "uk" ? "Мінеральна вата." : "Mineral wool."],
          [locale === "uk" ? "Вікна" : "Windows", locale === "uk" ? "Енергозберігаючі двокамерні склопакети REHAU або аналогічного класу." : "Energy-saving double-glazed REHAU windows or equivalent."],
          [locale === "uk" ? "Дах" : "Roof", locale === "uk" ? "Фальцева покрівля (Металочерепиця). Виробник Чехія." : "Standing seam roof (Metal tile). Czech manufacturer."],
          [locale === "uk" ? "Висота стелі" : "Ceiling height", locale === "uk" ? "2,80 м." : "2.80 m."],
          [locale === "uk" ? "Стан дуплексів" : "Condition", locale === "uk" ? "Після будівельників. За бажанням доступний ремонт під ключ від забудовника — вартість розраховується окремо." : "Shell & core. Turnkey renovation available from the developer — cost calculated separately."],
          [locale === "uk" ? "Водопостачання" : "Water supply", locale === "uk" ? "Власна артезіанська свердловина." : "Private artesian well."],
          [locale === "uk" ? "Каналізація" : "Sewage", locale === "uk" ? "Автономна станція очищення стічних вод (септик із дренажним полем)." : "Autonomous sewage treatment station (septic with drainage field)."],
          [locale === "uk" ? "Вхідні двері" : "Front door", locale === "uk" ? "Металеві двері (тимчасові)." : "Metal doors (temporary)."],
          [locale === "uk" ? "Паркомісце" : "Parking", locale === "uk" ? "Кожен дуплекс обладнаний власним місцем для автомобіля на території домоволодіння." : "Each duplex has its own parking space on the property grounds."],
        ] as [string, string][]).map(([term, desc]) => (
          <div class="rounded-[var(--ph-radius-xl)] border border-[var(--ph-border-strong)] bg-[var(--ph-surface)] p-5 shadow-[var(--ph-shadow-sm)]">
            <p class="text-[0.75rem] font-semibold uppercase tracking-wider text-[var(--ph-forest)]">{term}</p>
            <p class="mt-2 text-[0.875rem] leading-relaxed text-[var(--ph-ink-soft)]">{desc}</p>
          </div>
        ))}

        {/* Опалення — інтегровано в grid */}
        <div class="rounded-[var(--ph-radius-xl)] border-2 border-[var(--ph-forest)]/20 bg-[var(--ph-forest)]/[0.03] p-5 shadow-[var(--ph-shadow-sm)]">
          <p class="text-[0.75rem] font-semibold uppercase tracking-wider text-[var(--ph-forest)]">
            {locale === "uk" ? "Опалення" : "Heating"}
          </p>
          <p class="mt-2 text-[0.875rem] leading-relaxed text-[var(--ph-ink-soft)]">
            {locale === "uk"
              ? "Індивідуальна гібридна система. Покупець може обрати:"
              : "Individual hybrid system. Options:"}
          </p>
          <ul class="mt-2 space-y-1 text-[0.8125rem] text-[var(--ph-ink-soft)]">
            <li class="flex items-start gap-1.5"><span class="text-[var(--ph-forest)]">•</span> {locale === "uk" ? "підключення до газу" : "gas connection"}</li>
            <li class="flex items-start gap-1.5"><span class="text-[var(--ph-forest)]">•</span> {locale === "uk" ? "електричний котел" : "electric boiler"}</li>
            <li class="flex items-start gap-1.5"><span class="text-[var(--ph-forest)]">•</span> {locale === "uk" ? "камін-піч із розведенням труб" : "fireplace stove with pipe distribution"}</li>
          </ul>
          <p class="mt-3 text-[0.75rem] leading-relaxed text-[var(--ph-ink-muted)]">
            {locale === "uk"
              ? "Камін-піч поєднує функції каміна та печі: обігріває приміщення з видимим полум'ям. Котел — Bosch або аналогічного європейського виробника."
              : "Fireplace stove combines fireplace and furnace functions. Boiler — Bosch or equivalent European manufacturer."}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{/* Zoom lightbox */}
<div
  id="plan-lightbox"
  class="fixed inset-0 z-[200] hidden bg-black/90 backdrop-blur-sm"
  aria-hidden="true"
>
  <button
    id="plan-lightbox-close"
    class="absolute top-4 right-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-sm transition-colors hover:bg-white/25"
    aria-label="Закрити"
  >
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <div id="plan-lightbox-viewport" class="flex h-full w-full items-center justify-center overflow-hidden touch-none">
    <img id="plan-lightbox-img" src="" alt="" class="max-h-none max-w-none select-none" draggable="false" />
  </div>
</div>

<script>
  {
    const lb = document.getElementById('plan-lightbox')!;
    const vp = document.getElementById('plan-lightbox-viewport')!;
    const img = document.getElementById('plan-lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('plan-lightbox-close')!;

    let scale = 1;
    let tx = 0;
    let ty = 0;
    let startDist = 0;
    let startScale = 1;
    let dragging = false;
    let dragStart = { x: 0, y: 0 };
    let dragTxStart = 0;
    let dragTyStart = 0;

    const MIN_SCALE = 0.5;
    const MAX_SCALE = 5;

    function applyTransform() {
      img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    }

    function open(src: string, alt: string) {
      img.src = src;
      img.alt = alt;
      scale = 1; tx = 0; ty = 0;
      applyTransform();
      lb.classList.remove('hidden');
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lb.classList.add('hidden');
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLImageElement>('[data-plan-zoom]').forEach(el => {
      el.addEventListener('click', () => open(el.src, el.alt));
    });

    closeBtn.addEventListener('click', close);
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !lb.classList.contains('hidden')) close();
    });
    vp.addEventListener('click', e => { if (e.target === vp) close(); });

    let lastTap = 0;
    vp.addEventListener('click', e => {
      if (e.target !== img) return;
      const now = Date.now();
      if (now - lastTap < 300) {
        if (scale > 1.2) {
          scale = 1; tx = 0; ty = 0;
        } else {
          const rect = vp.getBoundingClientRect();
          const cx = e.clientX - rect.left - rect.width / 2;
          const cy = e.clientY - rect.top - rect.height / 2;
          scale = 3;
          tx = -cx * 2;
          ty = -cy * 2;
        }
        applyTransform();
      }
      lastTap = now;
    });

    vp.addEventListener('wheel', e => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? 0.9 : 1.1;
      const newScale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, scale * delta));
      const rect = vp.getBoundingClientRect();
      const cx = e.clientX - rect.left - rect.width / 2;
      const cy = e.clientY - rect.top - rect.height / 2;
      tx = cx - (cx - tx) * (newScale / scale);
      ty = cy - (cy - ty) * (newScale / scale);
      scale = newScale;
      applyTransform();
    }, { passive: false });

    vp.addEventListener('touchstart', e => {
      if (e.touches.length === 2) {
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        startDist = Math.hypot(dx, dy);
        startScale = scale;
      } else if (e.touches.length === 1 && scale > 1) {
        dragging = true;
        dragStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
        dragTxStart = tx;
        dragTyStart = ty;
      }
    }, { passive: true });

    vp.addEventListener('touchmove', e => {
      if (e.touches.length === 2) {
        e.preventDefault();
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        const dist = Math.hypot(dx, dy);
        scale = Math.min(MAX_SCALE, Math.max(MIN_SCALE, startScale * (dist / startDist)));
        applyTransform();
      } else if (e.touches.length === 1 && dragging) {
        e.preventDefault();
        tx = dragTxStart + (e.touches[0].clientX - dragStart.x);
        ty = dragTyStart + (e.touches[0].clientY - dragStart.y);
        applyTransform();
      }
    }, { passive: false });

    vp.addEventListener('touchend', () => { dragging = false; }, { passive: true });

    vp.addEventListener('mousedown', e => {
      if (scale <= 1 || e.target !== img) return;
      dragging = true;
      dragStart = { x: e.clientX, y: e.clientY };
      dragTxStart = tx;
      dragTyStart = ty;
      img.style.cursor = 'grabbing';
    });
    window.addEventListener('mousemove', e => {
      if (!dragging) return;
      tx = dragTxStart + (e.clientX - dragStart.x);
      ty = dragTyStart + (e.clientY - dragStart.y);
      applyTransform();
    });
    window.addEventListener('mouseup', () => {
      dragging = false;
      if (scale > 1) img.style.cursor = 'grab';
    });
  }
</script>
