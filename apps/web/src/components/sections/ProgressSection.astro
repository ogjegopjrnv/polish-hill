---
import { Check, Video } from "lucide-astro";
import { milestones } from "@data/milestones";
import type { Locale } from "@lib/i18n/translations";

const locale = (Astro.currentLocale ?? "uk") as Locale;
const done = milestones.filter((m) => m.status === "done").length;
---

<section id="progress" class="section bg-[var(--ph-bg)]">
  <div class="container-ph">
    <div class="reveal max-w-2xl">
      <span class="text-[0.75rem] font-semibold uppercase tracking-[0.15em] text-[var(--ph-forest)]">
        {locale === "uk" ? "Хід робіт" : "Construction progress"}
      </span>
      <h2 class="mt-3">
        {locale === "uk" ? "Будівництво вже триває" : "Construction is underway"}
      </h2>
      <p class="mt-4 text-[var(--ph-ink-soft)]">
        {locale === "uk"
          ? `Показуємо кожен етап відкрито — з відео прямо з будмайданчика. Завершено етапів: ${done} із ${milestones.length}.`
          : `We show every stage openly — with video straight from the site. Completed: ${done} of ${milestones.length} stages.`}
      </p>
      <p class="mt-2 text-[0.8125rem] text-[var(--ph-ink-muted)]">
        {locale === "uk" ? "Терміни орієнтовні." : "Timeline is approximate."}
      </p>
    </div>

    <ol class="mt-14" role="list">
      {milestones.map((m, idx) => (
        <li class="reveal relative flex gap-6 pb-12 last:pb-0 sm:gap-10" style={`transition-delay: ${idx * 80}ms;`}>
          {/* Rail */}
          <div class="flex flex-col items-center">
            <div
              class:list={[
                "flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2",
                m.status === "done"
                  ? "border-[var(--ph-forest)] bg-[var(--ph-forest)] text-white"
                  : "border-[var(--ph-border)] bg-[var(--ph-surface)] text-[var(--ph-ink-muted)]",
              ]}
            >
              {m.status === "done"
                ? <Check class="h-5 w-5" stroke-width={2.5} />
                : <span class="text-[0.8125rem] font-semibold">{idx + 1}</span>}
            </div>
            {idx < milestones.length - 1 && (
              <div
                class:list={[
                  "w-[2px] flex-1",
                  m.status === "done" ? "bg-[var(--ph-forest)]/40" : "bg-[var(--ph-border)]",
                ]}
              />
            )}
          </div>

          {/* Content */}
          <div class="grid flex-1 gap-6 pt-1 lg:grid-cols-[1fr_auto] lg:gap-12">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-[var(--ph-stone-deep)]">
                  {m.quarter}
                </span>
                {m.status === "done" && (
                  <span class="rounded-full bg-[var(--ph-forest)]/10 px-2.5 py-0.5 text-[0.6875rem] font-semibold text-[var(--ph-forest)]">
                    {locale === "uk" ? "Виконано" : "Done"}
                  </span>
                )}
              </div>
              <h3 class="mt-2 text-[1.25rem] font-semibold text-[var(--ph-ink)]">{m.title}</h3>
              <p class="mt-2 max-w-lg text-[0.9375rem] text-[var(--ph-ink-soft)]">{m.description}</p>
            </div>

            {m.video ? (
              <div class="relative w-full max-w-[280px] overflow-hidden rounded-[var(--ph-radius-xl)] shadow-[var(--ph-shadow-lg)]">
                <video
                  src={m.video}
                  poster={m.poster}
                  autoplay
                  muted
                  loop
                  playsinline
                  class="aspect-[9/16] w-full bg-black object-cover"
                  data-progress-video={m.id}
                >
                </video>
                <div class="absolute right-2 top-2 flex flex-col gap-2">
                  <button
                    type="button"
                    class="flex h-9 w-9 items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-sm transition-colors hover:bg-black/65"
                    data-progress-expand={m.video}
                    data-progress-expand-id={m.id}
                    aria-label={locale === "uk" ? "На весь екран" : "Fullscreen"}
                  >
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="flex h-9 w-9 items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-sm transition-colors hover:bg-black/65"
                    data-progress-sound={m.id}
                    aria-label={locale === "uk" ? "Увімкнути звук" : "Unmute"}
                  >
                    <svg data-icon="muted" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75 21 13.5m0-3.75-3.75 3.75M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.5a.75.75 0 0 1-.75-.75v-6a.75.75 0 0 1 .75-.75h2.25Z" />
                    </svg>
                    <svg data-icon="unmuted" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.5a.75.75 0 0 1-.75-.75v-6a.75.75 0 0 1 .75-.75h2.25Z" />
                    </svg>
                  </button>
                </div>
              </div>
            ) : (
              <div class="flex w-full max-w-[280px] flex-col items-center justify-center gap-2 self-start rounded-[var(--ph-radius-xl)] border border-dashed border-[var(--ph-border)] bg-[var(--ph-surface)] px-6 py-8 text-center">
                <Video class="h-6 w-6 text-[var(--ph-ink-muted)]" stroke-width={1.5} />
                <p class="text-[0.8125rem] text-[var(--ph-ink-muted)]">
                  {locale === "uk"
                    ? "Відео з'явиться після завершення етапу"
                    : "Video will appear once the stage is complete"}
                </p>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Video lightbox -->
<div
  id="progress-lightbox"
  class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/85 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label={locale === "uk" ? "Перегляд відео" : "Video player"}
>
  <button
    id="progress-lb-close"
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
    aria-label={locale === "uk" ? "Закрити" : "Close"}
  >
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <video
    id="progress-lb-video"
    controls
    playsinline
    preload="none"
    class="h-[85vh] max-w-[92vw] rounded-[var(--ph-radius-xl)] bg-black object-contain"
  >
  </video>
</div>

<script>
  const lightbox = document.getElementById("progress-lightbox");
  const player = document.getElementById("progress-lb-video") as HTMLVideoElement | null;
  const closeBtn = document.getElementById("progress-lb-close");
  const trackedVideos = new Set<string>();

  function openLightbox(src: string, videoId: string, startAt = 0) {
    if (!lightbox || !player) return;
    player.src = src;
    if (startAt > 0) player.currentTime = startAt;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
    player.play().catch(() => {});
    if (!trackedVideos.has(videoId)) {
      trackedVideos.add(videoId);
      window.gtag?.("event", "video_play", { video_id: videoId, section: "progress" });
    }
  }

  function closeLightbox() {
    if (!lightbox || !player) return;
    player.pause();
    player.removeAttribute("src");
    player.load();
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
    // Resume ambient autoplay in the section
    document.querySelectorAll<HTMLVideoElement>("video[data-progress-video]").forEach((v) => {
      v.play().catch(() => {});
    });
  }

  function track(videoId: string) {
    if (trackedVideos.has(videoId)) return;
    trackedVideos.add(videoId);
    window.gtag?.("event", "video_play", { video_id: videoId, section: "progress" });
  }

  // Sound toggle on the autoplaying inline video
  document.querySelectorAll<HTMLButtonElement>("[data-progress-sound]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const video = btn.closest("div.relative")?.querySelector<HTMLVideoElement>("video");
      if (!video) return;
      video.muted = !video.muted;
      btn.querySelector("[data-icon=muted]")?.classList.toggle("hidden", !video.muted);
      btn.querySelector("[data-icon=unmuted]")?.classList.toggle("hidden", video.muted);
      btn.setAttribute("aria-label", video.muted ? "Увімкнути звук" : "Вимкнути звук");
      if (!video.muted) track(btn.dataset.progressSound!);
    });
  });

  // Expand button → modal, continuing from inline position
  document.querySelectorAll<HTMLButtonElement>("[data-progress-expand]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const inline = btn.closest("div.relative")?.querySelector<HTMLVideoElement>("video");
      inline?.pause();
      track(btn.dataset.progressExpandId!);
      openLightbox(btn.dataset.progressExpand!, btn.dataset.progressExpandId!, inline?.currentTime ?? 0);
    });
  });

  closeBtn?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !lightbox?.classList.contains("hidden")) closeLightbox();
  });
</script>
